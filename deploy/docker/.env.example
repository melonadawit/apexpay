# ApexPay — environment template. Copy to the repo root as `.env` and fill in secrets.
#   cp deploy/docker/.env.example .env
# Generate strong values with:  openssl rand -hex 32

# ---- Database / cache / storage (compose defaults) ----
POSTGRES_DB=apexpay
POSTGRES_USER=apexpay
POSTGRES_PASSWORD=apexpay_dev

# ---- Application secrets (MUST change in production) ----
# Master key used to derive per-purpose encryption keys. 32+ random bytes.
CONNECTOR_ENCRYPTION_KEY=change_me_to_32_random_hex_bytes
# Reserved for future JWT features.
JWT_SECRET=change_me_to_32_random_hex_bytes

# ---- Fayda (mock in dev) ----
FAYDA_MODE=mock
FAYDA_PARTNER_CODE=APEXPAY_TEST
FAYDA_PARTNER_KEY=mock_key

# ---- RAG / compliance worker (compose service name) ----
RAG_SERVICE_URL=http://rag:8001

# ---- Merchant dashboard ----
# Fallback merchant API key injected by the merchant-web proxy when no dashboard session
# exists (dev convenience). Leave empty to require login. Use a TEST key, never a live one.
APEXPAY_MERCHANT_API_KEY=
