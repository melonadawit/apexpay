# Dockerfile.worker — Go Worker multi-stage Gold
# Jobs: outbox drain 1s, webhook retry 2s exponential backoff + SSRF block + HMAC, health sampler 30s, dunning 1d/3d/5d, recon 02:00 EAT, swarm executor, payroll calc

FROM golang:1.22-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app

# Cache mod
COPY services/api/go.mod services/api/go.sum* ./services/api/
WORKDIR /app/services/api
RUN go mod download

COPY services/api/ ./

WORKDIR /app/services/api

# Worker is a command in the same Go module, so internal packages are legal.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o /app/bin/worker ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /app/bin/worker /worker
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# No exposed port, worker only consumes PG + Redis

USER nonroot:nonroot

ENTRYPOINT ["/worker"]
